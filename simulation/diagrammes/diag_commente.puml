@startuml simulation_class_diagram_commente

title Simulation — Diagramme de classes (commenté : contexte & design patterns)

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam ArrowColor #333333
skinparam ClassBorderColor #4A90D9
skinparam ClassBackgroundColor #EAF4FF
skinparam ClassHeaderBackgroundColor #4A90D9
skinparam ClassHeaderFontColor #FFFFFF
skinparam PackageBorderColor #888888
skinparam PackageBackgroundColor #F8F8F8
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #C9B458

' =====================================================================
'  DÉPENDANCES ENTRE PACKAGES (DAG, sans cycle) :
'    mrta   -> core
'    algo   -> core, mrta        (fournit les implémentations concrètes)
'    client -> core              (via l'abstraction Coordinator + PlanResult)
'  mrta n'importe JAMAIS algo ni client. client n'importe JAMAIS algo.
' =====================================================================

package "core" #EAF4FF {

    package "entities" {
        class Position <<value object>> {
            + x : int
            + y : int
            --
            + __add__(other: Position) : Position
            + __repr__() : str
        }

        class WorldEntity {
            + entity_id       : int
            + position        : Position
            + appear_at       : int
            + blocks_movement : bool
            + scale           : int = 1
            --
            + active : bool
        }

        class Agent {
            + agent_id    : int
            + steps_taken : int
            --
            + move_to(new_position: Position) : void
            + __eq__(other: object) : bool
            + __hash__() : int
            + __repr__() : str
        }
    }

    package "environment" {
        class Grid {
            + width  : int
            + height : int
            - _agents : dict[Position, Agent]
            - _static : dict[Position, list[WorldEntity]]
            --
            + is_valid(position: Position) : bool
            + is_blocked(position: Position) : bool
            + place(entity: WorldEntity) : void
            + remove(entity: WorldEntity) : void
            + move(agent: Agent, new_position: Position) : bool
            + get_agent_at(position: Position) : Agent | None
            + get_entities_at(position: Position, kind) : list[WorldEntity]
            + get_all(kind) : list[WorldEntity]
            + __repr__() : str
        }
    }

    package "engine" {
        class PlanResult <<DTO>> {
            + positions   : dict[int, Position]
            + moves       : dict[int, tuple]
            + order       : list[int]
            + inheritance : list[tuple]
            + priorities  : dict[int, float]
        }

        abstract class Coordinator <<Strategy>> {
            + {abstract} plan(agents: list[Agent], grid: Grid) : PlanResult
            + set_goal(agent: Agent, target: Position) : void
        }

        abstract class PriorityBasedCoordinator {
            + {abstract} set_priority(agent: Agent, priority: float) : void
        }

        class Simulation {
            + grid         : Grid
            + agents       : list[Agent]
            + entities     : list[WorldEntity]
            - _pending     : list[WorldEntity]
            + current_step : int
            + coordinator  : Coordinator
            --
            + add_agent(agent: Agent) : void
            + add_object(entity: WorldEntity) : void
            + step() : void
            + __repr__() : str
        }
    }
}

package "client" #FFF5EA {

    class Renderer {
        + sim : Simulation
        --
        + run(steps: int, pause: float) : void
        - _draw(screen, font, font_sm, font_hdr, w, h) : void
    }

    class PIBTRenderer {
        --
        - _draw(screen, font, font_sm, font_hdr, w, h) : void
    }

    class StepSnapshot <<DTO>> {
        + step    : int
        + result  : PlanResult
        + goals   : dict[int, Position]
        + objects : list[tuple]
    }

    class PIBTInteractiveRenderer {
        + sim : Simulation
        --
        + run(steps: int, auto_ms: int) : void
        - _build_history(steps: int) : list[StepSnapshot]
        - _snapshot_objects() : list[tuple]
        - _run_loop(history, auto_ms) : void
        - _draw_header(...) : void
        - _draw_grid(...) : void
        - _draw_footer(...) : void
    }
}

package "mrta" #FFF0F5 {

    enum TaskState {
        PENDING
        ASSIGNED
        DONE
    }

    class Task {
        + task_id      : int
        + target       : Position
        + priority     : float
        + state        : TaskState
        + assignee     : Agent | None
        + created_step : int
    }

    abstract class TaskSource {
        + poll(current_step: int) : list[Task]
    }

    abstract class Allocator <<Strategy>> {
        + allocate(pending: list[Task], free: list[Agent], grid: Grid) : dict[Task, Agent]
    }

    class FleetManager {
        + source      : TaskSource
        + allocator   : Allocator
        + coordinator : PriorityBasedCoordinator
        + tasks       : list[Task]
        --
        + dispatch(agents: list[Agent], grid: Grid, step: int) : void
        + set_priority(task_id: int, priority: float) : void
        - _intake(step: int) : void
        - _allocate(agents: list[Agent], grid: Grid) : void
        - _complete(agents: list[Agent]) : void
    }
}

package "algo" #F0FFF0 {

    package "coordination" {
        class RandomWalkCoordinator {
            --
            + plan(agents: list[Agent], grid: Grid) : PlanResult
        }

        class ReservationTable {
            - _reserved : dict[Position, Agent]
            --
            + reserve(agent: Agent, pos: Position) : void
            + get_reserving_agent(pos: Position) : Agent | None
            + clear() : void
        }

        class PriorityManager {
            - _base    : dict[Agent, float]
            - _dynamic : dict[Agent, float]
            --
            + update(agents: list[Agent]) : void
            + get_priority(agent: Agent) : float
            + set_base(agent: Agent, p: float) : void
        }

        class PIBTCoordinator {
            + goals         : dict[Agent, Position]
            - _reservations : ReservationTable
            - _priorities   : PriorityManager
            - _processed    : set[Agent]
            --
            + plan(agents: list[Agent], grid: Grid) : PlanResult
            + set_goal(agent: Agent, target: Position) : void
            + set_priority(agent: Agent, priority: float) : void
            - _pibt(agent: Agent, parent: Agent | None, grid: Grid) : bool
            - _h(pos: Position, agent: Agent, grid: Grid) : int
        }
    }

    package "allocation" {
        class RandomAllocator {
            --
            + allocate(pending: list[Task], free: list[Agent], grid: Grid) : dict[Task, Agent]
        }

        class KDTreeGreedyAllocator {
            - _tree : KDTree
            --
            + allocate(pending: list[Task], free: list[Agent], grid: Grid) : dict[Task, Agent]
            - _nearest_free(task: Task, free: list[Agent]) : Agent
        }
    }
}

' ── Héritage & entités ────────────────────────────────────────────
WorldEntity <|-- Agent
WorldEntity "1" *-- "1" Position : position

' ── Grille ────────────────────────────────────────────────────────
Grid "1" *-- "0..*" WorldEntity : "> contain"

' ── Moteur : boucle de simulation ─────────────────────────────────
Simulation "1" *-- "1" Grid           : grid
Simulation "1" *-- "0..*" WorldEntity : entities
Simulation "1" o-- "1" Coordinator    : coordinator (partagé)
Coordinator ..> PlanResult : «returns»

' ── Hiérarchie des coordinateurs (Strategy + raffinement) ─────────
Coordinator <|-- PriorityBasedCoordinator
Coordinator <|.. RandomWalkCoordinator          
PriorityBasedCoordinator <|.. PIBTCoordinator   

' ── PIBT décomposé (Extract-Class) ────────────────────────────────
PIBTCoordinator "1" *-- "1" ReservationTable : _reservations
PIBTCoordinator "1" *-- "1" PriorityManager  : _priorities

' ── Client : découplé de algo, lit PlanResult ─────────────────────
Renderer "1" o-- "1" Simulation : sim
Renderer ..> WorldEntity : reads
PIBTRenderer --|> Renderer
PIBTInteractiveRenderer "1" o-- "1" Simulation : sim
PIBTInteractiveRenderer ..> StepSnapshot : builds
StepSnapshot "1" *-- "1" PlanResult : result

' ── MRTA ──────────────────────────────────────────────────────────
Task "1" *-- "1" TaskState : state

Allocator <|.. RandomAllocator       
Allocator <|.. KDTreeGreedyAllocator 

FleetManager "1" o-- "1" TaskSource              : source
FleetManager "1" o-- "1" Allocator               : allocator
FleetManager "1" o-- "1" PriorityBasedCoordinator : coordinator (partagé)
FleetManager "1" *-- "0..*" Task                 : tasks

' =====================================================================
'  NOTES : contexte de simulation & design patterns
' =====================================================================

note bottom of PlanResult
  **Data Transfer Object (DTO) — retour unifié de plan()**
  Norme de comparaison inter-algorithmes :
  • positions, moves = contrat universel (tout Coordinator)
  • order, inheritance, priorities = diagnostics
    optionnels (vides hors famille PIBT)
  Traverse la frontière core→client : c'est lui qui
  permet aux renderers de rester découplés de `algo`.
end note

note right of PriorityBasedCoordinator
  **Interface Segregation**
  set_priority isolée ici : RandomWalk (sans priorités)
  hérite de Coordinator sans être forcé de l'implémenter.
  La MÊME instance PIBTCoordinator est vue comme :
  • Coordinator            par Simulation  (plan / set_goal)
  • PriorityBasedCoordinator par FleetManager (set_priority)
end note

note bottom of PIBTCoordinator
  **Extract-Class** : l'ancien god-object PIBT éclaté.
  Réservations -> ReservationTable
  Priorités    -> PriorityManager
  Le cœur (_pibt / _h) reçoit `grid` en argument
  (aucun état de grille stocké).
end note

note top of FleetManager
  **Boucle de contrôle (contexte de simulation)** :
  1. FleetManager.dispatch : _intake -> _allocate ->
     set_goal / set_priority sur le coordinateur partagé
  2. Simulation.step : coordinator.plan -> Grid.move
  3. FleetManager._complete : tâches terminées
  Point de rendez-vous = le Coordinator partagé.
  mrta ne dépend que de core (Coordinator, Task, Position).
end note

@enduml
