' =====================================================================
'  Single source, two renderings.
'
'  The whole architecture lives in _model.iuml; this file only picks
'  how much annotation each rendering carries. Editing the model in one
'  place is what keeps the two diagrams from drifting apart.
'
'  Regenerate BOTH:
'      plantuml diagrammes/diagrams.puml
'
'  Outputs:
'      simulation_class_diagram_simple.png    — structure only
'      simulation_class_diagram_commente.png  — + design-pattern notes
' =====================================================================

@startuml simulation_class_diagram_simple
!$ANNOTATED = 0
title Simulation — Class diagram (simple)
!include _model.iuml
@enduml

@startuml simulation_class_diagram_commente
!$ANNOTATED = 1
title Simulation — Class diagram (annotated: context & design patterns)
!include _model.iuml
@enduml
