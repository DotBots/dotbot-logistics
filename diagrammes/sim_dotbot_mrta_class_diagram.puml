@startuml sim_dotbot_mrta_class_diagram

title sim_dotbot_mrta.py — current-code class decomposition (HTTP/WS surface annotated)

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam ArrowColor #333333
skinparam ClassBorderColor #4A90D9
skinparam ClassBackgroundColor #EAF4FF
skinparam ClassHeaderBackgroundColor #4A90D9
skinparam ClassHeaderFontColor #FFFFFF
skinparam PackageBorderColor #888888
skinparam PackageBackgroundColor #F8F8F8

package "mrta_mode (new — extracted from sim_dotbot_mrta.py)" #FFF0F5 {

    class GridStateManager <<kept as-is — REST client>> {
        + base_url : str
        + cell_mm : int | None
        + map_cells_x, map_cells_y : int
        --
        + fetch_dotbots() : list[dict]        <GET /controller/dotbots>
        + fetch_map_size() : (int, int)       <GET /controller/map_size>
        + set_map_size(width_mm, height_mm) : void
        + mm_to_cell(x_mm, y_mm) : Position
        + cell_to_mm(pos) : (float, float)
        + get_grid_state() : dict[str, Position]   <-- calls fetch_dotbots()
        + resolve_conflicts(positions) : dict[str, Position]
    }

    class WaypointWatcher <<kept as-is — WS client>> {
        + ws_url : str                        <ws://.../controller/ws/status>
        - _stop : Event
        --
        + start() : void
        + stop() : void
        + drain() : list[dict]
        - _listen_forever() : void
        - _handle_raw(raw) : void
    }
    note bottom of WaypointWatcher
      Connects to the controller's *single* broadcast channel,
      /controller/ws/status. Every message is a
      DotBotNotificationCommand — cmd=2 (UPDATE) carries
      **both** waypoint-set events (data.lh2_waypoints) and
      continuous LH2 position updates (data.lh2_position),
      the latter pushed on every advertisement frame the
      controller receives (PyDotBot controller.py:405-567).
      _handle_raw() keeps only messages with lh2_waypoints and
      silently drops the rest — so live position already
      arrives on this socket but is discarded, unused.
    end note

    class ManualClickTranslator <<new>> {
        - _commanded : dict[str, Position]
        --
        + seed_commanded(dotbots_raw) : void
        + record_commanded(address, cell) : void
        + translate(waypoints_mm) : list[Position]
        + is_self_commanded(event) : bool
        + reconcile() : list[dict]             <-- falls back to
                                                    GridStateManager.fetch_dotbots()
                                                    (GET /controller/dotbots) when
                                                    the WS link was down
    }
    note bottom of ManualClickTranslator
      absorbs former free functions:
      _waypoints_to_cells, _dedupe_consecutive,
      _is_self_commanded, _reconcile_from_rest
    end note

    class DotBotNavigator <<new — write-path REST client only>> {
        + base_url : str
        + threshold : int
        + step_timeout : float
        + settle_s : float
        --
        + send(address, waypoints_mm) : void         <PUT /controller/dotbots/{address}/0/waypoints>
        + send_all_parallel(moved_mm) : void          <N parallel PUTs, same route>
        + wait_until_all_arrived(targets) : set[str]  <-- polls GridStateManager.fetch_dotbots()
                                                           (GET /controller/dotbots) in a loop
    }
    note bottom of DotBotNavigator
      Despite the name, this does NOT read the WS status
      channel: arrival is confirmed by re-polling
      GET /controller/dotbots on a backoff loop (50ms->500ms),
      even though WaypointWatcher already holds a live
      connection to the same controller carrying position
      updates for free. Two decoupled data paths today by
      omission, not by an API constraint — see the WS variant
      of this diagram (sim_dotbot_mrta_ws_target_class_diagram).
    end note

    class MRTASession <<new — the "activatable mode" object>> {
        + sim : Simulation
        + fleet : FleetManager
        + queue_source : QueueTaskSource
        + agents : list[Agent]
        --
        + start() : void
        + stop() : void
        + handle_click(address, waypoints_mm, source) : void
        + tick(step) : void
        - _cancel_agent_tasks(agent_id) : void
    }
    note bottom of MRTASession
      absorbs build_mrta(), _cancel_agent_tasks()
      and the body of run_mrta_live()'s while-loop,
      split into start()/stop()/handle_click()/tick()
      so a caller can drive it one tick at a time
      instead of blocking on an infinite loop.
    end note

    class MRTACli <<kept, thinned>> {
        --
        + main() : void
    }
    note bottom of MRTACli
      argparse + wiring only; becomes one driver
      among others once the frontend can also
      start/stop a MRTASession directly.
    end note
}

package "simulation (existing engine, unchanged)" #EAF4FF {
    class Simulation
    class Agent
    class Position
    class FleetManager
    class QueueTaskSource
    class Task
    class PIBTCoordinator
    class EasiestAllocator
}

MRTASession *-- GridStateManager
MRTASession *-- WaypointWatcher
MRTASession *-- ManualClickTranslator
MRTASession *-- DotBotNavigator
MRTASession *-- Simulation
MRTASession *-- FleetManager
MRTASession *-- QueueTaskSource
MRTASession o-- Agent

ManualClickTranslator ..> GridStateManager : uses (mm_to_cell,\nREST fallback)
DotBotNavigator ..> GridStateManager : uses (cell_to_mm,\nREST arrival poll)

FleetManager o-- QueueTaskSource
FleetManager *-- Task
Simulation *-- PIBTCoordinator
Simulation *-- Agent

MRTACli ..> MRTASession : builds & runs (CLI driver)

@enduml
