@startuml arch_boundary
title Architecture detail A — mm <-> cell boundary: full REST API surface, GridStateManager, driver

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName sans-serif

package "mm world  —  DotBot Controller REST API (:8000)   — full surface, 3 categories" #FFEEEE {

    class "State reads" as READS <<GET>>
    note bottom of READS
      GET /controller/dotbots                 [✓ used]  -> [{address, lh2_position{x,y}, status}] (mm)
      GET /controller/map_size                [✓ used]  -> {width, height} (mm)
      GET /controller/dotbots/{address}
      GET /controller/background_map
    end note

    class "Commands" as CMDS <<PUT / DELETE>>
    note bottom of CMDS
      PUT    /controller/dotbots/{address}/{app}/waypoints  [✓ used]  <- {threshold, waypoints:[{x,y}]} (mm)
      PUT    /controller/dotbots/{address}/{app}/move_raw             (joystick / raw wheels)
      PUT    /controller/dotbots/{address}/{app}/rgb_led              (LED colour)
      DELETE /controller/dotbots/{address}/positions                 (clear position history)
    end note

    class "Real-time streams" as WS <<WebSocket>>
    note bottom of WS
      WS /controller/ws/dotbots     (live position/state pushes)
      WS /controller/ws/status      (controller status)
    end note
}

package "conversion boundary  —  real_dotbot_pibt / sim_dotbot_pibt (drivers)" #FFF9E6 {

    class GridStateManager {
        + base_url : str
        + cell_mm : int
        + map_cells_x : int
        + map_cells_y : int
        --
        + set_map_size(width_mm:int, height_mm:int)
        + fetch_dotbots() : list[dict]
        + fetch_map_size() : tuple[int,int]
        + mm_to_cell(x_mm:float, y_mm:float) : Position
        + cell_to_mm(pos:Position) : tuple[float,float]
        + get_grid_state() : dict[str,Position]
        + resolve_conflicts(positions:dict[str,Position]) : dict[str,Position]
    }
    note bottom of GridStateManager
      mm -> cell  (lossy): g = clamp(int(coord_mm / cell_mm), 0, map_cells-1)   sub-cell offset lost
      cell -> mm  (centre): coord_mm = g*cell_mm + cell_mm//2
      get_grid_state(): fetch_dotbots -> mm_to_cell -> resolve_conflicts
      resolve_conflicts(): two bots on one cell -> 2nd shifted to nearest free neighbour (8-dir)
      map_cells_* = max(1, width_mm // cell_mm)   (fallback square until fetch_map_size)
    end note

    class "driver" as DRV <<module>> {
        + _assign_random_goals(agents, grid, rng) : dict[Agent,Position]
        + build_pibt(grid_state, cells_x, cells_y, rng) : (sim, agents, addresses, goals_by_agent, goals_by_address)
        + fetch_grid_state_with_retry(gsm, min_bots, attempts=10, delay=1.0) : dict[str,Position]
        + run_pibt_live(gsm, sim, agents, addresses, goals_by_agent, threshold, steps, step_timeout, settle_s, dry_run)
        + wait_until_all_arrived(gsm, targets, threshold, step_timeout, settle_s) : set[str]
        + send_waypoints(base_url, address, waypoints_mm, threshold)
        + main()
    }
    note bottom of DRV
      run_pibt_live per step: sim.step() -> targets = agent.position -> moved = {changed cells}
      -> send_waypoints(cell_to_mm) for each moved -> wait_until_all_arrived (barrier) -> repeat
      wait_until_all_arrived: poll fetch_dotbots until every bot within threshold mm of target centre,
      or step_timeout (stalled bots logged, run continues -> no deadlock)
    end note
}

READS  -[#B00000]->  GridStateManager : fetch_dotbots / fetch_map_size (mm)
GridStateManager  -[#1E7D32]->  DRV : grid_state (cells)
DRV  -[#B00000]->  CMDS : send_waypoints  (PUT waypoints, mm)

@enduml
